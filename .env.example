# --- Copy to .env and fill ---

# Supabase (primary persisted store)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# MongoDB (MERN "M" — raw filing/dotnet doc store)
MONGODB_URI=mongodb://127.0.0.1:27017/anomaly_engine
MONGO_DB_NAME=anomaly_engine

# Redis (cache + task queue)
REDIS_URL=redis://default:PASSWORD@HOST:PORT/0

# External APIs
FINNHUB_API_KEY=
SEC_AUTH_EMAIL=

# ML model
FINBERT_MODEL=ProsusAI/finbert
MODEL_DEVICE=cpu

# SEC EDGAR
EDGAR_USER_AGENT=AnomalyEngine/1.0 (contact@yourdomain.com)

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
